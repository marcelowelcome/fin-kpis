# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API do Monde (v3, oficial)
# NÃO vai neste arquivo nem no Vercel. A chave do Monde abre o sistema inteiro,
# inclusive o financeiro, e só existe como secret da Edge Function `monde-sync`:
#   Supabase → Edge Functions → Secrets → MONDE_V3_API_KEY
# (valor = token Basic já codificado, base64 de login:senha). O Next.js não fala
# com o Monde: o botão "Atualizar" e o pg_cron chamam a Edge Function.

# Cron (Vercel)
# Segredo que protege o endpoint /api/cron/monde-sync. O Vercel injeta
# `Authorization: Bearer <CRON_SECRET>` nas chamadas agendadas (vercel.json).
# Gere um valor aleatório e configure o mesmo no painel do Vercel.
CRON_SECRET=your-random-cron-secret
